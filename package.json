{
  "name": "dsh-avatar-top",
  "version": "0.3.1",
  "description": "Move the sidebar account avatar (settings launcher) out of the bottom strip, with a Plugins-page settings card: placement (including a zero-height inline mode), row height, spacing, and an on/off switch.",
  "license": "MIT",
  "author": "kiefeng",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiefeng/dsh-avatar-top.git"
  },
  "homepage": "https://github.com/kiefeng/dsh-avatar-top#readme",
  "bugs": {
    "url": "https://github.com/kiefeng/dsh-avatar-top/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "ui",
    "sidebar",
    "avatar",
    "layout"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
